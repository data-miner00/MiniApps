<Window x:Class="ColorPicker.PickerOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ColorPicker"
        mc:Ignorable="d"
        Title="PickerOverlayWindow"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="#01000000"
        Topmost="True"
        ShowInTaskbar="False"
        Cursor="Cross"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        MouseMove="Window_MouseMove"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <Canvas x:Name="RootCanvas" Background="#01000000">
        <Border x:Name="Tooltip" Background="#DD222222" CornerRadius="4" Padding="6,3" IsHitTestVisible="False" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <Border x:Name="TooltipSwatch" Width="14" Height="14" Margin="0,0,6,0"
                        BorderBrush="White" BorderThickness="1" VerticalAlignment="Center"/>
                <TextBlock x:Name="TooltipText" Foreground="White" FontFamily="Consolas" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
