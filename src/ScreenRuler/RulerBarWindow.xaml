<Window x:Class="ScreenRuler.RulerBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenRuler"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Ruler"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#CCB8860B"
        Topmost="True"
        ShowInTaskbar="False"
        Width="400" Height="70"
        MinWidth="120" MinHeight="70"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        SizeChanged="Window_SizeChanged"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        KeyDown="Window_KeyDown">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </shell:WindowChrome.WindowChrome>
    <Grid>
        <Canvas x:Name="TickCanvas" ClipToBounds="True"/>
        <TextBlock x:Name="LengthText" Foreground="#3B2410" FontFamily="Consolas" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" IsHitTestVisible="False"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="4">
            <Button x:Name="OrientationButton" Content="&#8635;" Width="22" Height="22" Padding="0"
                    Click="OrientationButton_Click" Background="#33000000" Foreground="#3B2410" BorderThickness="0"
                    ToolTip="Toggle orientation"/>
            <Button x:Name="CloseButton" Content="&#215;" Width="22" Height="22" Padding="0" Margin="4,0,0,0"
                    Click="CloseButton_Click" Background="#33000000" Foreground="#3B2410" BorderThickness="0"
                    ToolTip="Close"/>
        </StackPanel>
    </Grid>
</Window>
