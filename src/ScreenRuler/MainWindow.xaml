<Window x:Class="ScreenRuler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ScreenRuler"
        mc:Ignorable="d"
        Title="Screen Ruler"
        Height="220" Width="300"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <RadioButton x:Name="MeasureModeRadio" Grid.Row="0" Content="Measure two points"
                     GroupName="Mode" IsChecked="True" Checked="Mode_Checked" Margin="0,0,0,8"/>
        <RadioButton x:Name="RulerModeRadio" Grid.Row="1" Content="Ruler bar"
                     GroupName="Mode" Checked="Mode_Checked" Margin="0,0,0,16"/>

        <Button x:Name="StartButton" Grid.Row="2" Content="Start" Padding="8,6" Click="StartButton_Click"/>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,14,0,0"
                   TextWrapping="Wrap" Foreground="Gray" FontSize="11" HorizontalAlignment="Center"/>
    </Grid>
</Window>
